# ---------------------------------------------------------------------------
# Neo Drug — environment variables
# Copy this file to .env for local development, and set the same variables in
# your hosting provider (Vercel → Project → Settings → Environment Variables).
# ---------------------------------------------------------------------------

# --- Required in production -------------------------------------------------
# Long random strings (>= 32 chars). Generate with: openssl rand -base64 48
# IMPORTANT: never commit real secrets here — set them in Vercel instead.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_KEY=replace-with-a-long-random-admin-key

# Postgres connection string. Without it, serverless deployments fall back to an
# ephemeral SQLite copy in /tmp and accounts/usage/promos will NOT persist.
# The app automatically switches the driver to pg8000.
# Get your real URL from: neon.tech, supabase.com, or your RDS/Azure Postgres,
# then set DATABASE_URL in Vercel → Settings → Environment Variables.
DATABASE_URL=postgresql://user:password@host:5432/neodrug?sslmode=require

# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=https://neo-drug.vercel.app

# --- Google Sign-In ---------------------------------------------------------
# Comma-separated OAuth client IDs accepted by /api/auth/google.
GOOGLE_CLIENT_ID=632334576806-ta1instgonlh0rmbq4mdun5917s8n2lu.apps.googleusercontent.com

# --- AI provider (Gemini-only) ----------------------------------------------
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional tuning --------------------------------------------------------
# TOKEN_EXPIRATION_DAYS=30
# JSON array of promo codes to seed on startup. Never commit real codes.
# DEFAULT_PROMO_CODES=[{"code":"TRIAL7","duration_days":7,"max_uses":100}]
# Override the Gemini fallback chain (comma separated, first = preferred).
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# Base URL used by the desktop app to verify/exchange cloud tokens.
# NEO_CLOUD_API_BASE=https://neo-drug.vercel.app
